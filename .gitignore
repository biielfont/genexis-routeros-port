logs/
*.log

# --- Artefactos de Python y del sistema ---
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.idea/
.vscode/

# --- Imagenes y volcados de firmware ---
*.zip
*.img
*.bin
*.BIN
*.y3
*.npk
*.squashfs
*.elf
*.dtb

# --- Sistema ---
.DS_Store
Thumbs.db

